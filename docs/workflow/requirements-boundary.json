  "user_extensions": [
    {
      "id": "USR-01",
      "title": "六人a-f按领域负责前后端完整spec",
      "basis": "本轮用户明确确认",
      "acceptance": [
        "每个spec有唯一责任人；个人报告按本人拆分",
        "分工是计划，登记身份及权限另行配置，不以字母代号认证"
      ]
    },
    {
      "id": "USR-02",
      "title": "细粒度spec、明确场景与依赖拓扑",
      "basis": "本轮用户明确要求",
      "acceptance": [
        "全部任务书及附加需求可追到spec和稳定场景",
        "场景包含确定初态、动作、结果及边界，设计建议与原文分开",
        "图无环，区分契约准备、真实联调和外部条件"
      ]
    },
    {
      "id": "USR-03",
      "title": "skill采用执行条件、输入、Stage、输出和完成条件",
      "basis": "前一轮用户明确要求",
      "acceptance": [
        "五个技能入口直接呈现完整结构",
        "总入口能恢复检查点、继续独立项，只有真实人工门禁才交接"
      ]
    },
    {
      "id": "USR-04",
      "title": "公共组件、请求工具及中英字典先行",
      "basis": "历史用户明确要求，沿用现有基线",
      "acceptance": [
        "统一样式、组件与请求/错误处理可复用",
        "业务文案在本模块中英字典，公共层冻结"
      ]
    },
    {
      "id": "USR-05",
      "title": "简洁文案、三角色骨架及平滑切换",
      "basis": "历史用户明确要求，精细视觉后做",
      "acceptance": [
        "只保留标题、字段、操作、状态与必要错误，不放介绍性占位长文",
        "导航切换保留外壳、不整页刷新，有可减少的过渡动画",
        "精细视觉参考wisepen方向，但不把未确认视觉稿作为本轮像素验收"
      ]
    },
    {
      "id": "USR-06",
      "title": "普通注册登录取代学校UIS认证",
      "basis": "用户明确取消学校认证，允许注册",
      "acceptance": [
        "不要求复旦UIS、学号或学校密码，注册默认为普通用户",
        "管理员维护院系/整室资格，本地账号不声称已证明复旦身份"
      ]
    },
    {
      "id": "USR-07",
      "title": "Gitee仓库与可审查提交说明",
      "basis": "用户指定FduStudyRoom及提交说明审查",
      "acceptance": [
        "目标为https://gitee.com/wangjr2021/fdu-study-room.git，正式提交说明可供真人审查",
        "保留IDE内置Git操作说明，不提交凭据，不自动解冲突"
      ]
    },
    {
      "id": "USR-08",
      "title": "简化数据库及可读表结构文档",
      "basis": "历史用户明确要求",
      "acceptance": [
        "不建组织树等无必要结构；任务书院系限制用最小资格字段保留",
        "每表列字段类型、非空、主外键和其他约束，字段作用置表下，附ER图"
      ]
    }
  ],
