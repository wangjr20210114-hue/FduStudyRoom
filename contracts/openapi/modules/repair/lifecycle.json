    "/api/repairs": {
      "post": {
        "description": "repair:report. Optional seatId UUID must belong to actual room; omit if no seat. Same operation/actor/payload returns original snapshot; different content409. SUBMITTED does not restrict resources. Body never supplies reporter identity. Creation replays also201.",
        "security": [
          {
            "Session": [],
            "Csrf": []
          }
        ],
        "responses": {
          "201": {
            "description": "Committed result; resource transitions may remain pending"
          },
          "400": {
            "description": "Invalid fields or candidate"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Current permission, ownership, CSRF or independent inspector denied"
          },
          "404": {
            "description": "Unknown resource/order"
