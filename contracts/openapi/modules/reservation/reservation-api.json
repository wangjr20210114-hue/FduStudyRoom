  "components": {
    "securitySchemes": {
      "ServiceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Key"
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "FDU_SESSION",
        "description": "Production __Host-FDU_SESSION; mutations also require the existing CSRF header."
      }
    },
    "schemas": {
      "Statistics": {
        "type": "object",
        "properties": {
          "checkedInCount": {
            "type": "integer",
            "minimum": 0
          },
          "noShowCount": {
            "type": "integer",
            "minimum": 0
          },
          "excludedBeforeStartCancelledCount": {
            "type": "integer",
            "minimum": 0
          },
          "excludedSystemTerminatedCount": {
            "type": "integer",
            "minimum": 0
          },
          "notDueCount": {
            "type": "integer",
            "minimum": 0
          },
          "pendingEvaluationCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Due, previously confirmed, still RESERVED, not cancelled before start or system-terminated, and without persisted check-in/no-show outcome. GET does not execute the scheduler. Excluded from notDueCount; consumers must show incomplete outcomes."
          },
          "excludedUnconfirmedCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Due records never confirmed by M1; never fabricate a no-show penalty."
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "roomId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "algorithm": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "checkedInCount",
          "noShowCount",
          "excludedBeforeStartCancelledCount",
          "excludedSystemTerminatedCount",
          "notDueCount",
          "pendingEvaluationCount",
          "excludedUnconfirmedCount",
          "from",
          "to",
          "asOf",
          "roomId",
          "algorithm",
          "source"
        ]
      },
      "ReservationState": {
        "type": "string",
        "enum": [
          "PENDING",
          "RESERVED",
          "CHECKED_IN",
          "COMPLETED",
          "CANCEL_PENDING",
          "CANCELLED",
          "NO_SHOW",
          "REJECTED"
        ]
      },
      "MaintenanceReceipt": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "duplicate": {
            "type": "boolean"
          },
          "ignored": {
            "type": "boolean"
          },
          "appliedSourceVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "operationId",
          "duplicate",
          "ignored",
          "appliedSourceVersion"
        ]
      },
      "ReleaseProgress": {
        "type": "object",
        "additionalProperties": false,
        "readOnly": true,
        "description": "Optional snapshot of only the reservation current resourceVersion RELEASE task. Omitted if that exact task does not exist; an older DONE task never implies current success. GET only observes and never dispatches, claims or changes retry times.",
        "required": [
          "status",
          "attempts",
          "nextRetryAt",
          "errorCode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CLAIMED",
              "DONE",
              "CANCELLED"
            ],
            "description": "Outbox task status, distinct from reservation status. DONE and resourceState=RELEASED are both required before displaying resource release success."
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "description": "Actual number of claims, including in-flight and successful claims; this is not a failure counter."
          },
          "nextRetryAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Only PENDING exposes the persisted UTC planned earliest next attempt; not a promised processing time. Other states expose null. Existing cancellation retries still honor this time; no force-retry API is added."
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(DEPENDENCY_HTTP_[1-5][0-9]{2}|INVALID_RESOURCE_RELEASE|RESERVATION_DEPENDENCY_UNAVAILABLE|RESERVATION_DELIVERY_UNAVAILABLE|RELEASE_DEPENDENCY_UNAVAILABLE)$",
            "description": "Last completed failure for PENDING/CLAIMED only; terminal tasks expose null. Unknown stored errors are normalized to RELEASE_DEPENDENCY_UNAVAILABLE. No raw exception, URL, key, payload, response or claim data is public."
          }
        }
      },
      "ReleaseAwareReservation": {
        "type": "object",
        "properties": {
          "releaseProgress": {
            "$ref": "#/components/schemas/ReleaseProgress"
          }
        },
        "description": "All existing reservation properties and permissions remain unchanged; releaseProgress is additive and optional."
      },
      "ReleaseAwareHistory": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReleaseAwareReservation"
            }
          }
        },
        "description": "Existing signed pagination and owner/admin scope unchanged. At most 100 already-visible rows share one batched own-domain outbox read."
      }
    }
  }
}
