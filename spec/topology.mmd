flowchart TB
  subgraph M01["账号与权限"]
    S002["S002 注册账号并安全保存密码"]
    S003["S003 登录、重新打开页面和退出"]
    S004["S004 管理员配置角色和可以使用的功能"]
    S005["S005 管理员修改账号权限和使用资格"]
    S006["S006 管理员设置预约时长和各类时限"]
    S007["S007 所有功能都按当前登录人的身份和权限处理"]
    S008["S008 登录后显示各角色的菜单并平滑切换页面"]
    S009["S009 切换中英文，使用清楚一致的页面提示"]
    S081["S081 填写和验证通知邮箱，缺邮箱时给出明确提示"]
  end
  subgraph M02["教室与座位"]
    S014["S014 管理员新增、修改和停用教室"]
    S015["S015 管理员维护座位编号、插座和启用状态"]
    S016["S016 按开放时间和已确认的院系资格开放教室"]
    S017["S017 防止两个人订到同一座位，也防止一人同时占多个座位"]
    S018["S018 整间教室要么全部订到，要么全部不订"]
    S019["S019 维修时停用整间教室，恢复时逐项检查原因"]
    S020["S020 查清座位为什么被占用，并避免重复操作"]
    S021["S021 每天为每间教室显示当天签到码"]
    S022["S022 查看外部空教室信息，并说明来源和接入情况"]
    S024["S024 查询座位时，一起检查预约、维修和使用资格"]
  end
  subgraph M03["个人预约与签到"]
    S026["S026 搜索座位并按地点、时间和插座筛选"]
    S027["S027 提交预约时检查整点、时长和实际占用结果"]
    S028["S028 取消自己的预约，或由管理员说明理由后取消"]
    S029["S029 在网页输入教室当天的签到码"]
    S030["S030 预约开始前15分钟发提醒"]
    S031["S031 开始10分钟还没签到，再发一次提醒"]
    S032["S032 开始15分钟仍未签到，自动取消并记录违约"]
    S033["S033 查看我的预约历史，并重新选择预约"]
    S034["S034 网络中断或服务重启后，把预约结果查清楚"]
    S079["S079 维修开始后，结束受影响的个人预约但不记违约"]
  end
  subgraph M04["整室申请与审批"]
    S038["S038 有资格的用户提交整间教室申请"]
    S039["S039 管理员设置逐级审批的人选和期限"]
    S040["S040 审批人依次通过或说明理由后驳回"]
    S041["S041 最后一级通过后，确认整间教室确实订下"]
    S042["S042 撤销申请、处理到期，并正确释放整室占用"]
    S043["S043 查看整室申请进度、办理记录和状态通知"]
    S044["S044 审批结果同步失败后，保存待办并自动核对"]
  end
  subgraph M05["报修与维修"]
    S050["S050 用户上报故障并查看自己的报修"]
    S051["S051 管理员派单、转派，并保留负责人记录"]
    S052["S052 维护人员开始维修后，停用整间教室并处理已有预约"]
    S053["S053 维修超过时限时提醒管理员，并保留原负责人"]
    S054["S054 维修人申请完工，由另一人验收后再恢复"]
    S055["S055 验收方评分，并保留每一轮返工记录"]
    S056["S056 取消工单时，确认维修中的教室是否安全"]
    S060["S060 维修同步遇到故障后，继续核对限制和恢复结果"]
  end
  subgraph M06["通知、统计与助手"]
    S062["S062 查看站内消息，避免重复通知和过时提醒"]
    S063["S063 保存关键操作记录，并隐藏密码和密钥"]
    S064["S064 管理员查看预约、签到和违约统计"]
    S068["S068 AI助手先问清需求，再按用户权限操作（附加）"]
    S069["S069 用AI助手查座位、预约和查看自己的历史（附加）"]
    S070["S070 用AI助手提交整室申请、查进度和撤销（附加）"]
    S071["S071 用AI助手报修、查询工单和申请取消（附加）"]
    S078["S078 实际发送邮件，失败可重试，结果不明就提示待核实"]
    S082["S082 发送邮箱验证邮件并显示真实投递结果"]
  end
