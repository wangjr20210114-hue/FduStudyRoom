{
  "name": "fdu-team-buffer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build with the frozen frontend/package-lock.json; no independent dependency installation.",
  "scripts": {
    "build": "node ../../../frontend/node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node ../../../frontend/node_modules/vite/bin/vite.js build",
