{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "../../../frontend",
    "paths": {
      "vue": [
        "node_modules/vue"
      ],
      "vue-i18n": [
        "node_modules/vue-i18n"
      ],
      "vitest": [
        "node_modules/vitest"
      ],
      "vue/server-renderer": [
        "node_modules/vue/server-renderer"
      ]
    },
    "typeRoots": [
      "../../../frontend/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts"
  ]
}
