# Configure these in the shell before starting Java. Spring does not load this file automatically.
CAMPUS_DB_URL=jdbc:postgresql://127.0.0.1:55432/fdu_study_room
CAMPUS_DB_USER=campus_resource
CAMPUS_DB_PASSWORD=replace-with-the-same-local-database-password
# Generate a Base64-encoded random key of at least 32 bytes.
CAMPUS_AUTH_SIGNING_KEY=
# Generate a separate random service key of at least 32 characters.
CAMPUS_AUTH_SERVICE_KEY=
